# Credenciais LuciLuci — NUNCA use NEXT_PUBLIC_* aqui
#
# Preferir BASE64 se a senha tiver $ { } (Next faz dotenv-expand e corrompe).
# Gerar: echo -n 'sua_senha' | node -e "let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>console.log(Buffer.from(s).toString('base64')))"
# Ou: coloque a senha em .env.password e rode: node scripts/setup-password-b64.mjs
API_USERNAME=seu_usuario
API_PASSWORD_BASE64=

# Alternativa (só se a senha NÃO tiver $):
# API_PASSWORD=sua_senha_sem_dolar

# Opcional (default: https://escritorio.luciluci.com.br)
LUCI_BASE_URL=https://escritorio.luciluci.com.br

# Gemini (Parte 2 — gerações de declaração de conteúdo)
GEMINI_API_KEY=
# Opcional (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
